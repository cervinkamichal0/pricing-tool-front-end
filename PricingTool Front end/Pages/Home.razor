@page "/"
@using PricingTool_Front_end.Components

<PageTitle>PricingTool</PageTitle>

<h1 class="text-center fw-bold">Co prodáváte?</h1>
<EditForm OnSubmit="@FetchSimilarAds" class="card p-5 shadow-lg rounded-4" style="margin:2% 10%;" EditContext=@editContext>
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="card-body d-flex flex-column gap-4">
        <label class="fw-semibold">
            <span>Název inzerátu:</span>
            <InputText @bind-Value="UsersAdd.Title" class="form-control rounded-3" />
            <ValidationMessage For=@(() => UsersAdd.Title) />

        </label>

        <label class="fw-semibold">
            <span>Popis:</span>
            <InputTextArea @bind-Value="UsersAdd.Description" class="form-control rounded-3" rows="3" />
            <ValidationMessage For=@(() => UsersAdd.Description) />

        </label>

        <label class="fw-semibold">
            <span>Obrázek:</span>
            <div style="height:10%;">
                <ImageInput OnImageSelected="@HandleImageUpload" Height="300px" Width="100%" />
                <ValidationMessage For=@(() => UsersAdd.Image) />
            </div>
        </label>
        <div class="hstack justify-content-between align-items-center">
            <label class="fw-semibold flex-column">
                <span>Návrh Ceny:</span>
                <div style="height:10%;">
                    <input type="number" @bind="UsersAdd.Price" class="form-control rounded-3" rows="3" disabled=@PriceNotCalculated />
                </div>
            </label>

            <div class="btn-group align-self-end" role="group">
                <input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off" checked @onchange="@(() => UsersAdd.Price = SimilarAdsResponse.EstimatedPrice)"
                       disabled=@PriceNotCalculated>
                <label class="btn btn-outline-primary" for="btnradio1"
                       style="border-bottom-left-radius:var(--pill-border-radius); border-top-left-radius:var(--pill-border-radius)">
                    Nespěchám na prodej
                </label>

                <input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off" @onchange="@(() => UsersAdd.Price = SimilarAdsResponse.QuickPrice)"
                       disabled=@PriceNotCalculated>
                <label class="btn btn-outline-primary" for="btnradio2"
                       style="border-bottom-right-radius:var(--pill-border-radius); border-top-right-radius:var(--pill-border-radius);">
                    Spěchám na prodej
                </label>
            </div>

        </div>
        <div class="alert alert-danger" role="alert" hidden=@isErrorHidden>
            @ErrorMessage
        </div>
        <button type="submit" class="btn btn-primary rounded-3 fs-5 fw-bold">Nacenit</button>
    </div>
</EditForm>

@if (SimilarAdsResponse.SimilarAds.Any())
{
    <div class="mt-5">
        <h2>Podobné inzeráty:</h2>
        <div class="list-group">
            @foreach (var ad in SimilarAdsResponse.SimilarAds)
            {
                <a href="@ad.Url" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">@ad.Title</h5>
                        <small class="text-muted">Podobnost: @Math.Round((ad.SimilarityScore * 100), 1)%</small>
                    </div>
                    <span class="badge bg-primary rounded-pill">@ad.Price Kč</span>
                </a>
            }
        </div>
    </div>
}
