@page "/"
@using PricingTool_Front_end.Components
@using PricingTool_Front_end.Models

<PageTitle>PricingTool</PageTitle>

<h1 class="text-center fw-bold">Co prodáváte?</h1>
<!--Hlavní formulář-->
<EditForm OnValidSubmit="FetchSimilarAds" class="card p-5 shadow-lg rounded-3 mx-auto" style="max-width: 800px;" Model="FormUsersAdd">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="card-body d-flex flex-column gap-4">
        <!--Název inzerátu-->
        <label class="fw-semibold">
            <span>Název inzerátu:</span>
            <InputText @bind-Value="FormUsersAdd.Title" class="form-control rounded-3" />
            <ValidationMessage For=@(() => FormUsersAdd.Title) />
        </label>

        <!--Popis inzerátu-->
        <label class="fw-semibold vstack gap-1">
            <div class="hstack">
                <span>Popis:</span>
                <!--Tlačítko pro generování popisu s indikací čekání na výsledek-->
                @if(!IsDescriptionLoading)
                {
                    <button class="ms-auto btn btn-primary rounded-3" @onclick="suggest_description" type="button">
                        <!--ikonka hvězdiček-->
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-stars" viewBox="0 0 16 16">
                            <path d="M7.657 6.247c.11-.33.576-.33.686 0l.645 1.937a2.89 2.89 0 0 0 1.829 1.828l1.936.645c.33.11.33.576 0 .686l-1.937.645a2.89 2.89 0 0 0-1.828 1.829l-.645 1.936a.361.361 0 0 1-.686 0l-.645-1.937a2.89 2.89 0 0 0-1.828-1.828l-1.937-.645a.361.361 0 0 1 0-.686l1.937-.645a2.89 2.89 0 0 0 1.828-1.828zM3.794 1.148a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387A1.73 1.73 0 0 0 4.593 5.69l-.387 1.162a.217.217 0 0 1-.412 0L3.407 5.69A1.73 1.73 0 0 0 2.31 4.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387A1.73 1.73 0 0 0 3.407 2.31zM10.863.099a.145.145 0 0 1 .274 0l.258.774c.115.346.386.617.732.732l.774.258a.145.145 0 0 1 0 .274l-.774.258a1.16 1.16 0 0 0-.732.732l-.258.774a.145.145 0 0 1-.274 0l-.258-.774a1.16 1.16 0 0 0-.732-.732L9.1 2.137a.145.145 0 0 1 0-.274l.774-.258c.346-.115.617-.386.732-.732z" />
                        </svg>
                        Navrhnout
                    </button>
                }
                else
                {
                    <button class="ms-auto btn btn-primary rounded-3" type="button" disabled>
                        <span class="spinner-grow spinner-grow-sm" role="status" aria-hidden="true"></span>
                        Načítání...
                    </button>
                }
            </div>
            <InputTextArea @bind-Value="FormUsersAdd.Description" class="form-control rounded-3" rows="6" />
            <ValidationMessage For=@(() => FormUsersAdd.Description) />
        </label>

        <!--Obrázek-->
        <label class="fw-semibold">
            <span>Obrázek:</span>
            <div>
                <ImageInput OnImageSelected="@HandleImageUpload" MaxHeight="300px" />
                <ValidationMessage For=@(() => FormUsersAdd.Image) />
            </div>
        </label>
        <!--Návrh ceny-->
        <div class="row">
            <div class="col-12 col-md-6">
                <label class="fw-semibold">
                    <span>Návrh Ceny:</span>
                    <input type="number" @bind="FormUsersAdd.Price" class="form-control rounded-3" disabled />
                </label>
            </div>
            <!--Přepínání mezi rychlím a normálním prodejem-->
            <div class="col-12 col-md-6 text-md-end text-center">
                <div class="btn-group" role="group">
                    <input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off" checked @onchange="@(() => FormUsersAdd.Price = SimilarAdsResponse.EstimatedPrice)" disabled=@PriceNotCalculated>
                    <label class="btn btn-outline-primary" for="btnradio1">Nespěchám na prodej</label>

                    <input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off" @onchange="@(() => FormUsersAdd.Price = SimilarAdsResponse.QuickPrice)" disabled=@PriceNotCalculated>
                    <label class="btn btn-outline-primary" for="btnradio2">Spěchám na prodej</label>
                </div>
            </div>
        </div>

        <!--Zobrazování chybové hlášky-->
        <div class="alert alert-danger" role="alert" hidden=@isErrorHidden>
            @ErrorMessage
        </div>

        <!--Tlačítko pro vypočítání ceny s indikací čekání na výsledek-->
        <div class="text-center">
            @if (!IsPriceLoading)
            {
                <button type="submit" class="btn btn-primary rounded-3 fs-5 fw-bold w-100">Nacenit</button>
            }
            else
            {
                <button class="btn btn-primary rounded-3 fs-5 fw-bold w-100" type="button" disabled>
                    <span class="spinner-grow spinner-grow-sm" role="status" aria-hidden="true"></span>
                    Načítání...
                </button>
            }
        </div>
    </div>
</EditForm>

<!--Zobrazení nejpodobnějších inzerátů-->
@if (SimilarAdsResponse.SimilarAds.Any())
{
    <div class="card p-5 shadow-lg rounded-3 mx-auto mt-4" style="max-width: 800px;">
        <h2>Podobné inzeráty:</h2>
        <div class="list-group">
            @foreach (var ad in SimilarAdsResponse.SimilarAds)
            {
                <a href="@ad.Url" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center flex-column flex-md-row">
                    <div class="text-center text-md-start">
                        <h5 class="mb-1">@ad.Title</h5>
                        <small class="text-muted">Podobnost: @Math.Round((ad.SimilarityScore * 100), 1)%</small>
                    </div>
                    <span class="badge bg-primary rounded-pill">@ad.Price Kč</span>
                </a>
            }
        </div>
    </div>
}
