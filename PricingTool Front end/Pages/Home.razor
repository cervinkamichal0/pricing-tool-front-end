@page "/"
@using PricingTool_Front_end.Components

<PageTitle>PricingTool</PageTitle>

<h1 class="text-center fw-bold">Co prodáváte?</h1>
<EditForm OnSubmit="(async () => await FetchSimilarAds())" class="card p-5 shadow-lg rounded-3 mx-auto" style="max-width: 800px;" EditContext=@editContext>
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="card-body d-flex flex-column gap-4">
        <label class="fw-semibold">
            <span>Název inzerátu:</span>
            <InputText @bind-Value="UsersAdd.Title" class="form-control rounded-3" />
            <ValidationMessage For=@(() => UsersAdd.Title) />
        </label>

        <label class="fw-semibold">
            <span>Popis:</span>
            <InputTextArea @bind-Value="UsersAdd.Description" class="form-control rounded-3" rows="3" />
            <ValidationMessage For=@(() => UsersAdd.Description) />
        </label>

        <label class="fw-semibold">
            <span>Obrázek:</span>
            <div>
                <ImageInput OnImageSelected="@HandleImageUpload" MaxHeight="300px" />
                <ValidationMessage For=@(() => UsersAdd.Image) />
            </div>
        </label>

        <div class="row">
            <div class="col-12 col-md-6">
                <label class="fw-semibold">
                    <span>Návrh Ceny:</span>
                    <input type="number" @bind="UsersAdd.Price" class="form-control rounded-3" disabled />
                </label>
            </div>
            <div class="col-12 col-md-6 text-md-end text-center">
                <div class="btn-group" role="group">
                    <input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off" checked @onchange="@(() => UsersAdd.Price = SimilarAdsResponse.EstimatedPrice)" disabled=@PriceNotCalculated>
                    <label class="btn btn-outline-primary" for="btnradio1">Nespěchám na prodej</label>

                    <input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off" @onchange="@(() => UsersAdd.Price = SimilarAdsResponse.QuickPrice)" disabled=@PriceNotCalculated>
                    <label class="btn btn-outline-primary" for="btnradio2">Spěchám na prodej</label>
                </div>
            </div>
        </div>

        <div class="alert alert-danger" role="alert" hidden=@isErrorHidden>
            @ErrorMessage
        </div>

        <div class="text-center">
            @if (!IsLoading)
            {
                <button type="submit" class="btn btn-primary rounded-3 fs-5 fw-bold w-100">Nacenit</button>
            }
            else
            {
                <button class="btn btn-primary rounded-3 fs-5 fw-bold w-100" type="button" disabled>
                    <span class="spinner-grow spinner-grow-sm" role="status" aria-hidden="true"></span>
                    Načítání...
                </button>
            }
        </div>
    </div>
</EditForm>

@if (SimilarAdsResponse.SimilarAds.Any())
{
    <div class="card p-5 shadow-lg rounded-3 mx-auto mt-4" style="max-width: 800px;">
        <h2>Podobné inzeráty:</h2>
        <div class="list-group">
            @foreach (var ad in SimilarAdsResponse.SimilarAds)
            {
                <a href="@ad.Url" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center flex-column flex-md-row">
                    <div class="text-center text-md-start">
                        <h5 class="mb-1">@ad.Title</h5>
                        <small class="text-muted">Podobnost: @Math.Round((ad.SimilarityScore * 100), 1)%</small>
                    </div>
                    <span class="badge bg-primary rounded-pill">@ad.Price Kč</span>
                </a>
            }
        </div>
    </div>
}
