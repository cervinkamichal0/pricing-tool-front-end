@page "/"
@using PricingTool_Front_end.Components

<PageTitle>PricingTool</PageTitle>

<h1 class="text-center fw-bold">Co prodáváte?</h1>
<EditForm OnSubmit="@FetchSimilarAds" Model="UsersAdd" class="card p-5 shadow-lg rounded-4" style="margin:2% 10%;">
    
    <div class="card-body d-flex flex-column gap-4">
        <label class="fw-semibold">
            <span>Název inzerátu:</span>
            <InputText @bind-Value="UsersAdd.Title" class="form-control rounded-pill" />
        </label>

        <label class="fw-semibold">
            <span>Krátký popis:</span>
            <InputTextArea @bind-Value="UsersAdd.Descritpiton" class="form-control rounded-3" rows="3" />
        </label>

        <label class="fw-semibold">
            <span>Obrázek:</span>
            <div style="height:10%;">
                <ImageInput OnImageSelected="@HandleImageUpload" Height="300px" Width="100%"/>
            </div>
        </label>

        <label class="fw-semibold">
            <span>Obrázek:</span>
            <div style="height:10%;">
                <InputTextArea @bind-Value="UsersAdd.Descritpiton" class="form-control rounded-3" rows="3" />
            </div>
        </label>

        <button type="submit" class="btn btn-primary rounded-pill fs-5 fw-bold">Nacenit</button>
    </div>

</EditForm>

@if (SimilarAdsResponse.SimilarAds.Any())
{
    <div class="mt-5">
        <h2>Podobné inzeráty:</h2>
        <div class="list-group">
            @foreach (var ad in SimilarAdsResponse.SimilarAds)
            {
                <a href="@ad.Url" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">@ad.Title</h5>
                        <small class="text-muted">Podobnost: @(ad.SimilarityScore * 100)%</small>
                    </div>
                    <span class="badge bg-primary rounded-pill">@ad.Price Kč</span>
                </a>
            }
        </div>
    </div>
}
